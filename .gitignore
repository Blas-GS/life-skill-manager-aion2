# --- Python environment ---
.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- Secrets: never commit the Supabase key ---
.env
.env.*
!.env.example

# --- Local data ---
# Profiles, levels, inventory, price history, offline queue, calibration.
# The catalog (data/catalogo.json) and the download cache (data/cache_metabot/) are
# generated on each machine with tools/importar_metabot.py: they are metabot.gg data
# and are not redistributed.
data/*
!data/.gitkeep

# Temporary market screenshots and videos (the ones in tests/fixtures are synthetic and are committed)
/capturas/

# --- Personal starting files ---
*.xlsx
aion2_crafting_calculator*.html

# --- Local working files (Claude Code settings, worktrees, internal plans) ---
.claude/
docs/plan.md
docs/contratos.md
