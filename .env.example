# Copia este archivo como ".env" (iniciar.bat lo hace solo) y rellena los dos valores
# con los de TU PROPIO proyecto de Supabase (cada usuario usa su cuenta y sus datos).
# Si los dejas vacíos, la app usa la base de datos local data/aion2.db.
# Guía: docs/supabase.md. No compartas ni subas nunca el archivo .env (está en .gitignore).

# Project URL, p.ej. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# Clave SECRETA (sb_secret_... o la antigua service_role). Solo la usa el backend local.
SUPABASE_KEY=
