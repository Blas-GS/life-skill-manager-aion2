# Copy this file as ".env" (iniciar.bat does it for you) and fill in both values
# with those of YOUR OWN Supabase project (each user uses their own account and data).
# If you leave them empty, the app uses the local database data/aion2.db.
# Guide: docs/supabase.md. Never share or upload the .env file (it is in .gitignore).

# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# SECRET key (sb_secret_... or the legacy service_role). Only the local backend uses it.
SUPABASE_KEY=
